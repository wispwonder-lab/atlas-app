const VAPID_PUBLIC_KEY = 'BHSMvNNjdlgzE6fgm7V9x2ofluK5qbyXh5UY-JRexbpwDwIaDKJg5vUA28Fljcf9CYyI2LGZjwXmGqBJ-lkTCsU';

function urlBase64ToUint8Array(base64String){
  const padding = '='.repeat((4 - base64String.length % 4) % 4);
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  const rawData = atob(base64);
  const outputArray = new Uint8Array(rawData.length);
  for(let i = 0; i < rawData.length; i++){ outputArray[i] = rawData.charCodeAt(i); }
  return outputArray;
}

async function checkNotificationStatus(){
  if(!('serviceWorker' in navigator) || !('PushManager' in window)) return;
  try {
    const reg = await navigator.serviceWorker.getRegistration();
    if(!reg) return;
    const existingSub = await reg.pushManager.getSubscription();
    if(existingSub){
      $('#notify-toggle').setAttribute('aria-pressed', 'true');
      $('#notify-toggle').textContent = 'On';
    }
  } catch(e) { /* silently ignore — not critical to login */ }
}

$('#notify-toggle').addEventListener('click', async () => {
  const btn = $('#notify-toggle');
  const currentlyOn = btn.getAttribute('aria-pressed') === 'true';
  clearError();

  if(!('serviceWorker' in navigator) || !('PushManager' in window)){
    showError('Notifications are not supported on this device or browser.');
    return;
  }

  if(!currentlyOn){
    try{
      const reg = await navigator.serviceWorker.register('/sw.js');
      const permission = await Notification.requestPermission();
      if(permission !== 'granted'){
        showError('Notifications were not allowed. You can turn this on later from your device settings.');
        return;
      }
      const subscription = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });
      const subJson = subscription.toJSON();
      const { data: userData } = await db.auth.getUser();
      const { error } = await db.from('push_subscriptions').insert({
        user_id: userData.user.id,
        endpoint: subJson.endpoint,
        p256dh: subJson.keys.p256dh,
        auth_key: subJson.keys.auth
      });
      if(error){
        showError('We could not save your notification settings right now. Technical detail: ' + error.message);
        return;
      }
      btn.setAttribute('aria-pressed', 'true');
      btn.textContent = 'On';
      announce('Notifications turned on for this device.');
    } catch(e){
      showError('We could not turn on notifications right now. Technical detail: ' + e.message);
    }
  } else {
    try{
      const reg = await navigator.serviceWorker.getRegistration();
      const existingSub = reg ? await reg.pushManager.getSubscription() : null;
      if(existingSub){
        await db.from('push_subscriptions').delete().eq('endpoint', existingSub.endpoint);
        await existingSub.unsubscribe();
      }
      btn.setAttribute('aria-pressed', 'false');
      btn.textContent = 'Off';
      announce('Notifications turned off for this device.');
    } catch(e){
      showError('We could not turn off notifications right now. Technical detail: ' + e.message);
    }
  }
});

